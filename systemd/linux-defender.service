[Unit]
Description=Linux Defender file and archive monitor
After=default.target

[Service]
Type=simple
# Update this path if the repository is not cloned to ~/Linux-Defender.
WorkingDirectory=%h/Linux-Defender
ExecStart=/usr/bin/python3 -m linux_defender.monitor
Restart=on-failure
RestartSec=5
Environment=LINUX_DEFENDER_WATCH_PATHS=%h/Downloads
Environment=LINUX_DEFENDER_MAX_FILE_SIZE_MB=100
Environment=LINUX_DEFENDER_MAX_UNCOMPRESSED_MB=500
Environment=LINUX_DEFENDER_MAX_ZIP_RATIO=100
Environment=LINUX_DEFENDER_MAX_ZIP_ENTRIES=10000
Environment=LINUX_DEFENDER_SCAN_INTERVAL_SECONDS=30

[Install]
WantedBy=default.target
